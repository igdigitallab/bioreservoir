# Copy to .env.local for local dev (gitignored) or set as real values in the deploy environment.
# Names only here — see site/README.md "Env vars".
# Local dev: Cloudflare's public "always passes" test key, safe to commit (not a secret).
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
VITE_API_BASE=
VITE_PUBLIC_URL=
VITE_USE_MOCK=1
